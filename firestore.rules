rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email != null && (
          request.auth.token.email.lower() == 'hr.sandiprajak466@gmail.com' || 
          request.auth.token.email.lower() == 'shauryahr466@gmail.com'
        )) ||
        request.auth.uid == 'DLwQZN91epQvBOtR3BHpWpsTCK23'
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        ('role' in getUserData()) && 
        getUserData().role == role;
    }

    function isAdmin() {
      return isSuperAdmin() || hasRole('Admin') || hasRole('Editor') || isSignedIn();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Specific collection rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    match /employees/{employeeId} {
      allow read, write: if true;
    }

    match /punches/{punchId} {
      allow read: if true;
      allow write: if true;
    }

    match /attendance/{atId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /sbl/{docId} {
      allow read, write: if true;
    }

    match /overtime/{docId} {
      allow read, write: if true;
    }

    match /forceAttendance/{docId} {
      allow read, write: if true;
    }

    match /shiftAssignments/{asId} {
      allow read, write: if true;
    }

    match /assignmentLogs/{logId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    match /exceptions/{exId} {
      allow read, write: if true;
    }

    match /payrollRuns/{runId} {
      allow read, write: if true;
    }

    match /zkDevices/{deviceId} {
      allow read: if true;
      allow write: if true;
    }

    match /zkUserMappings/{mappingId} {
      allow read, write: if true;
    }

    match /zkSyncLogs/{logId} {
      allow read, write: if true;
    }

    match /zkUnmappedPunches/{punchId} {
      allow read, write: if true;
    }
    match /zkRawEvents/{eventId} {
      allow read, write: if true;
    }
}
}
